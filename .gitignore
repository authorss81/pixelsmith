# Rust
/core/target/
**/target/
**/*.rs.bk

# Python
# scripts/lockfile-policy.py, scripts/deny-negative-control.py and scripts/sbom.py
# are imported or exec'd by the supply-chain checks, and running them drops a
# __pycache__ beside the source. That file was committed and then deleted in
# phase-15, came back on the next run, and is a build artefact of a check rather
# than part of any policy.
__pycache__/
*.pyc

# Fuzzing
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# Flutter / Dart
/app/.dart_tool/
/app/.flutter-plugins
/app/.flutter-plugins-dependencies
/app/.packages
/app/build/
/app/android/.gradle/
/app/android/local.properties
/app/ios/Pods/
/app/ios/.symlinks/
/app/macos/Pods/
/app/linux/flutter/ephemeral/
/app/windows/flutter/ephemeral/
/app/macos/Flutter/ephemeral/
/app/**/GeneratedPluginRegistrant.*
**/*.iml

# Native build output of the engine
/app/src/rust/.dart_tool/
/native/
*.so
*.dylib
*.dll
*.a
*.lib

# Pipeline state that must never be committed by accident.
# NOTE: workspace/.runs is deliberately NOT ignored. It is the run budget, and
# the only copy that survives the runner being wiped lives on main. An earlier
# revision ignored it, so the budget reset to 0 on every run and the cap never
# actually capped anything.
/logs/
workspace/.stop
workspace/*/.session
workspace/*/.checkpoint

# Secrets — belt and braces; the workflow uses Actions secrets
*.keystore
*.jks
.env
.env.*
secrets/

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp