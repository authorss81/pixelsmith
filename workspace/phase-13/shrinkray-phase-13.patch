+/// What to do when the output format cannot hold every frame of an animation.
+///
+/// Mirrors `AnimationPolicy` in `core/src/animation.rs` (`snake_case`).
+///
+/// [keep] is the default and the reason `docs/GIF.md` exists: an animation the
+/// format *can* hold goes through the pipeline frame by frame, and one it cannot
+/// is refused rather than quietly reduced. [firstFrame] is the explicit opt-in
+/// for a caller who has decided a still is what they want, and it reports what
+/// the decision cost.
+enum AnimationPolicy {
+  keep,
+  firstFrame;
+
+  String toJson() => switch (this) {
+    AnimationPolicy.keep => 'keep',
+    AnimationPolicy.firstFrame => 'first_frame',
+  };
+
+  static AnimationPolicy fromJson(String value) =>
+      AnimationPolicy.values.byName(_camelCase(value));
+}
+
+/// What happened to one file's frames.
+///
+/// Mirrors `AnimationAction` in `core/src/animation.rs` (`snake_case`).
+///
+/// A word rather than a pair of counts, because the counts alone cannot tell
+/// "this was never an animation" from "we could not read it", and that
+/// difference is the difference between a report and a guess.
+enum AnimationAction {
+  /// The file failed, was cancelled, or was refused before its frames were
+  /// read. Zero frames in *and* out, which is the only honest count for "we
+  /// never got that far".
+  unknown,
+
+  /// One frame in, one frame out. The file was a still, and nothing was lost.
+  still,
+
+  /// Every frame was carried through the pipeline with its delay.
+  preserved,
+
+  /// One frame was written out of several, deliberately, because the caller
+  /// asked for that with [AnimationPolicy.firstFrame].
+  flattened,
+
+  /// Nothing was written, because the format could not hold the frames and the
+  /// caller had not asked for them to be dropped.
+  refused;
+
+  String toJson() => name;
+
+  static AnimationAction fromJson(String value) =>
+      AnimationAction.values.byName(value.toLowerCase());
+}
+
+/// The animation half of a file's report.
+///
+/// Mirrors `AnimationOutcome` in `core/src/animation.rs`. A caller reads this to
+/// find out whether the animation survived without decoding the output and
+/// without parsing the error string.
+final class AnimationOutcome {
+  const AnimationOutcome({
+    required this.framesIn,
+    required this.framesOut,
+    required this.policy,
+    required this.action,
+  });
+
+  /// How many frames the input had.
+  final int framesIn;
+
+  /// How many the written file has. Zero when nothing was written, which covers
+  /// both a refusal and a failure.
+  final int framesOut;
+
+  /// The policy the request was made under.
+  final AnimationPolicy policy;
+
+  /// What was done.
+  final AnimationAction action;
+
+  /// How many frames the user did not get.
+  int get dropped => framesIn > framesOut ? framesIn - framesOut : 0;
+
+  /// Whether the file had more than one frame.
+  bool get animated => framesIn > 1;
+
+  /// Whether the whole animation went through the pipeline frame by frame.
+  bool get isPreserved => action == AnimationAction.preserved;
+
+  /// What to tell a person about this file's frames, or null when there is
+  /// nothing to say.
+  ///
+  /// Only a flattening has anything to say: it is the one case where a file was
+  /// written and something the user gave us is not in it. The sentence names the
+  /// count, what the file actually is, and what would have kept the rest.
+  String? get note {
+    if (action != AnimationAction.flattened) return null;
+    return 'This file was an animation of $framesIn frames. The exported image '
+        'is the first frame; the other $dropped were not written. '
+        'Choose GIF output to keep every frame.';
+  }
+
+  static AnimationOutcome fromJson(Map<String, Object?> json) =>
+      AnimationOutcome(
+        framesIn: (json['frames_in'] as num?)?.toInt() ?? 0,
+        framesOut: (json['frames_out'] as num?)?.toInt() ?? 0,
+        policy: AnimationPolicy.fromJson(json['policy'] as String? ?? 'keep'),
+        action: AnimationAction.fromJson(
+          json['action'] as String? ?? 'unknown',
+        ),
+      );
+}
+
+/// `snake_case` to `lowerCamelCase`, for the enum names serde emits.
+///
+/// Only the enums whose Rust names are multi-word need it; `keep` and `still`
+/// come through unchanged.
+String _camelCase(String value) {
+  final parts = value.split('_');
+  return [
+    parts.first,
+    for (final part in parts.skip(1)) part[0].toUpperCase() + part.substring(1),
+  ].join();
+}
