+      # ---------------------------------------------------------------------
+      # The negative control.
+      #
+      # `cargo deny check` being enabled is a configuration claim. Whether it
+      # would actually reject a GPL dependency or a yanked crate is a different
+      # claim, and only this step tests it: three known violations are injected
+      # into a copy of deny.toml, each must be rejected, and if any is accepted
+      # the job fails. Without it, a silently-misconfigured policy -- a removed
+      # key, a skip list that matched everything -- would sit here reporting
+      # green for as long as nobody added a bad dependency.
+      #
+      # Nothing here touches the real deny.toml, and `git diff --exit-code`
+      # proves it at the end rather than assuming it.
+      - name: Negative control — an injected violation must be rejected
+        run: |
+          set -euo pipefail
+          cargo install cargo-deny --locked
+          cp deny.toml /tmp/deny-injected.toml
+
+          expect_rejected() {
+            local what="$1" check="$2"
+            if cargo deny --config /tmp/deny-injected.toml \
+                 --manifest-path core/Cargo.toml check ${check} >/tmp/deny-out 2>&1; then
+              echo "::error::NEGATIVE CONTROL FAILED: cargo deny accepted ${what}"
+              sed 's/^/    /' /tmp/deny-out
+              exit 1
+            fi
+            echo "ok: rejected ${what}"
+            sed -n '1,6p' /tmp/deny-out | sed 's/^/    /'
+          }
+
+          # 1. A crate that is certainly in the tree, named in [bans].deny.
+          #    `image` is a direct dependency; nothing would remove it.
+          cat >> /tmp/deny-injected.toml <<'EOF'
+
+          [[bans.deny]]
+          name = "image"
+          reason = "NEGATIVE CONTROL — injected by supply-chain.yml, not a real policy decision"
+          EOF
+          expect_rejected "[bans].deny naming a crate that is in the tree" bans
+          cp deny.toml /tmp/deny-injected.toml
+
+          # 2. Every duplicate version un-skipped. The real tree carries six
+          #    duplicated crate names (miniz_oxide, syn, getrandom, itertools,
+          #    quick-error, r-efi), so emptying [bans].skip must be rejected —
+          #    and this is also what proves the skip list is load-bearing rather
+          #    than decorative.
+          sed -i 's/^skip = \[/skip = [ ]\n# [/' /tmp/deny-injected.toml
+          expect_rejected "a duplicate version with no [bans].skip entry" bans
+          cp deny.toml /tmp/deny-injected.toml
+
+          # 3. A wildcard version requirement. Added to a throwaway copy of the
+          #    manifest rather than to the tree, so the committed file is
+          #    untouched.
+          cp core/Cargo.toml /tmp/Cargo.toml.injected
+          cat >> /tmp/Cargo.toml.injected <<'EOF'
+          px-deny-negative-control = { version = "*" }
+          EOF
+          mkdir -p /tmp/nc/core /tmp/nc/src
+          cp /tmp/Cargo.toml.injected /tmp/nc/core/Cargo.toml
+          cp core/Cargo.lock /tmp/nc/core/Cargo.lock
+          cp deny.toml /tmp/nc/deny.toml
+          if cargo deny --manifest-path /tmp/nc/core/Cargo.toml check bans >/tmp/deny-out 2>&1; then
+            echo "::error::NEGATIVE CONTROL FAILED: cargo deny accepted a wildcard requirement"
+            exit 1
+          fi
+          echo "ok: rejected a wildcard version requirement"
+
+          git diff --exit-code -- deny.toml core/Cargo.toml core/Cargo.lock \
+            || { echo "::error::a negative control modified a tracked file"; exit 1; }
+          echo "ok: no tracked file was modified"
+
+      # The offline half of the same policy, plus its own control. Runs on every
+      # push so a contributor without cargo-deny installed still gets a verdict,
+      # and so scripts/deny-check.sh itself cannot rot unnoticed.
+      - name: Offline policy subset, with its own negative control
+        run: bash scripts/deny-check.sh --negative-control
+
