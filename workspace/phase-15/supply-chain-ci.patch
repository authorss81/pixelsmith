+          retention-days: 14
+
+  # ---------------------------------------------------------------------------
+  # Reproducible builds.
+  #
+  # "Build it twice and compare hashes" in its obvious form cannot fail: two
+  # builds in the same directory agree with each other whether or not the binary
+  # would match one built anywhere else. The two things that actually break
+  # byte-identity are the build path (rustc bakes it into panic locations) and the
+  # toolchain version, and neither shows up in a same-directory double build.
+  #
+  # So this job builds each target the way scripts/build-release.sh does --
+  # --remap-path-prefix, SOURCE_DATE_EPOCH pinned, incremental off, --locked --
+  # and compares the hash against the row already committed for that target in
+  # scripts/BUILD-SHA256.txt. That row was written by an earlier run, on an
+  # earlier runner, which is what makes this a two-runner comparison rather than
+  # a self-consistency check.
+  #
+  # A row reading "not measured" is not a mismatch and must not be reported as
+  # one: the job publishes the hash it got, and filling the table in is a commit.
+  reproducible-build:
+    name: reproducible build ${{ matrix.target }}
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 40
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - { target: x86_64-unknown-linux-gnu, os: ubuntu-latest }
+          - { target: x86_64-pc-windows-msvc, os: windows-latest }
+          - { target: x86_64-apple-darwin, os: macos-latest }
+          - { target: aarch64-apple-darwin, os: macos-latest }
+          - { target: aarch64-linux-android, os: ubuntu-latest }
+          - { target: aarch64-apple-ios, os: macos-latest }
+    steps:
+      - uses: actions/checkout@v5
+
+      - uses: dtolnay/rust-toolchain@stable
+        with:
+          targets: ${{ matrix.target }}
+
+      # Android needs the NDK's linker; a plain --target fails at link time.
+      - name: Install cargo-ndk
+        if: contains(matrix.target, 'android')
+        run: cargo install cargo-ndk
+
+      - name: Build the release engine reproducibly
+        shell: bash
+        run: |
+          if [[ "${{ matrix.target }}" == *android* ]]; then
+            # cargo-ndk owns both the linker and the target-dir layout, so the
+            # reproducibility flags have to ride on RUSTFLAGS and the artefact
+            # copied out of wherever ndk put it.
+            export RUSTFLAGS="--remap-path-prefix=$PWD=."
+            export SOURCE_DATE_EPOCH=0 CARGO_INCREMENTAL=0 CARGO_NET_OFFLINE=true
+            cargo ndk -t arm64-v8a -o /tmp/px-repro build --release --lib
+            find /tmp/px-repro -name 'libpixelsmith_core.so' -exec cp {} /tmp/libpixelsmith_core.so \;
+          else
+            bash scripts/build-release.sh --target "${{ matrix.target }}" \
+              --record /tmp/BUILD-SHA256.txt | tee /tmp/build.log
+            mkdir -p /tmp/art
+            cp core/target/"${{ matrix.target }}"/release/libpixelsmith_core.* /tmp/art/ 2>/dev/null || true
+          fi
+
+      - name: Compare against the committed hash
+        shell: bash
+        run: |
+          set -uo pipefail
+          TARGET="${{ matrix.target }}"
+          ART=$(ls /tmp/art/libpixelsmith_core.* /tmp/libpixelsmith_core.so 2>/dev/null | head -n1)
+          [ -n "${ART}" ] || { echo "::error::no release artefact produced for ${TARGET}"; exit 1; }
+
+          GOT=$(sha256sum "${ART}" | awk '{print $1}')
+          echo "### reproducible build ${TARGET}" >> "$GITHUB_STEP_SUMMARY"
+          echo '```' >> "$GITHUB_STEP_SUMMARY"
+          echo "${TARGET}  ${GOT}  $(basename "${ART}")" >> "$GITHUB_STEP_SUMMARY"
+          echo '```' >> "$GITHUB_STEP_SUMMARY"
+
+          # A row is "<target> <hash> ...". If the second field is not 64 hex
+          # characters the row says "not measured", which is not a mismatch.
+          ROW=$(grep -E "^${TARGET}[[:space:]]" scripts/BUILD-SHA256.txt 2>/dev/null | head -n1 || true)
+          EXPECTED=$(printf '%s' "${ROW}" | awk '{print $2}' || true)
+
+          if ! printf '%s' "${EXPECTED}" | grep -Eq '^[0-9a-f]{64}$'; then
+            echo "::notice::${TARGET} has no committed hash yet (scripts/BUILD-SHA256.txt)."
+            echo "  Above is the hash to record. Not a failure on the first run."
+            exit 0
+          fi
+
+          if [ "${EXPECTED}" != "${GOT}" ]; then
+            echo "::error::${TARGET} did not reproduce."
+            echo "  committed: ${EXPECTED}"
+            echo "  this run:  ${GOT}"
+            echo "  Either the toolchain moved or the build is not reproducible;"
+            echo "  docs/SUPPLY-CHAIN.md says which."
+            exit 1
+          fi
+          echo "OK: ${TARGET} reproduced ${EXPECTED}"
