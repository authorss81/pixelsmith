+/// One field's position inside a `#[repr(C)]` struct. Mirrors `FieldLayout` in
+/// `core/src/ffi_abi.rs`.
+final class AbiField {
+  const AbiField({
+    required this.name,
+    required this.offset,
+    required this.size,
+  });
+
+  final String name;
+  final int offset;
+  final int size;
+
+  static AbiField fromJson(Map<String, Object?> json) => AbiField(
+    name: json['name'] as String,
+    offset: (json['offset'] as num).toInt(),
+    size: (json['size'] as num).toInt(),
+  );
+}
+
+/// The engine's own answer to where `PxBuffer`'s fields live.
+///
+/// Dart reads the struct by byte offset, so this is the only number worth
+/// asserting against: a constant in a test proves someone once counted
+/// correctly, this proves the library that was actually loaded has the layout
+/// the declaration assumes, on whatever target it was compiled for.
+final class AbiLayout {
+  const AbiLayout({
+    required this.name,
+    required this.size,
+    required this.align,
+    required this.fields,
+  });
+
+  final String name;
+  final int size;
+  final int align;
+  final List<AbiField> fields;
+
+  int? offsetOf(String field) {
+    for (final f in fields) {
+      if (f.name == field) return f.offset;
+    }
+    return null;
+  }
+
+  static AbiLayout fromJson(Map<String, Object?> json) => AbiLayout(
+    name: json['name'] as String,
+    size: (json['size'] as num).toInt(),
+    align: (json['align'] as num).toInt(),
+    fields: (json['fields'] as List)
+        .map((f) => AbiField.fromJson((f as Map).cast<String, Object?>()))
+        .toList(),
+  );
+}
