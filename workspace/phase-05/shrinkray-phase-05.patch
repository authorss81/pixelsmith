+# === The PixelSmith engine ===
+# The Dart side calls into a Rust cdylib that nothing else in this build knows
+# about. Without the rules below, `flutter build linux` produces a bundle whose
+# loader cannot find libpixelsmith_core.so: the app starts, the first engine call
+# throws a dlopen error, and the cause is invisible. The compile itself is done by
+# native/build-engine.sh, which is the same script the README and CI use, so
+# there is exactly one definition of how the engine gets built.
+set(PIXELSMITH_ENGINE_SCRIPT "${CMAKE_CURRENT_SOURCE_DIR}/../native/build-engine.sh")
+set(PIXELSMITH_ENGINE_OUT "${CMAKE_CURRENT_SOURCE_DIR}/../src/rust")
+
+# Empty means "work it out": the script looks for a sibling pixelsmith checkout and
+# then for the superproject layout, which is what a submodule checkout is.
+set(PIXELSMITH_ENGINE_DIR "" CACHE PATH
