+List<int> _takeBytes(PxBindings px, PxBuffer buffer) {
+  try {
+    expect(buffer.status, PxStatus.ok, reason: _error(buffer));
+    return buffer.data.asTypedList(buffer.len).toList();
+  } finally {
+    px.bufferFree(buffer);
   }
-  // iOS and macOS link statically; process() always "succeeds" even with
-  // nothing in it, so only use it when the file actually exists.
-  if (Platform.isIOS || Platform.isMacOS) {
-    return ffi.DynamicLibrary.process();
+}
+
+Object? _decode(PxBuffer buffer) =>
+    jsonDecode(utf8.decode(buffer.data.asTypedList(buffer.len)));
+
+String _error(PxBuffer buffer) =>
+    buffer.error == ffi.nullptr ? '' : buffer.error.cast<Utf8>().toDartString();
+
+/// An uncompressed 24-bit BMP: the simplest container to build without an
+/// encoder, and one the engine decodes.
+List<int> _bmp(int width, int height) {
+  final rowBytes = width * 3;
+  final padded = rowBytes + (4 - rowBytes % 4) % 4;
+  final pixels = <int>[];
+  // Rows are stored bottom-up and each channel is blue first.
+  for (var y = height - 1; y >= 0; y--) {
+    for (var x = 0; x < width; x++) {
+      pixels
+        ..add((x * 255 ~/ width) & 0xFF)
+        ..add((y * 255 ~/ height) & 0xFF)
+        ..add(128);
+    }
+    while (pixels.length % padded != 0) {
+      pixels.add(0);
+    }
   }
-  return null;
+  return [..._bmpHeaderOnly(width, height), ...pixels];
 }
+
+/// Just the 54-byte header, for a file whose pixels are deliberately absent.
+///
+/// `px_inspect` reads the header and stops, which is the whole point of a
+/// header-only check: a 400-megapixel claim costs nothing to reject.
+List<int> _bmpHeaderOnly(int width, int height) => <int>[
+  0x42, 0x4D, // "BM"
+  ..._le32(54), // file size: only the header exists
+  0, 0, 0, 0, // reserved
+  ..._le32(54), // pixel data offset
+  40, 0, 0, 0, // DIB header size
+  ..._le32(width),
+  ..._le32(height),
+  1, 0, // planes
+  24, 0, // bits per pixel
+  0, 0, 0, 0, // compression: none
+  ..._le32(width * height * 3), // image size
+  0, 0, 0, 0, // pixels per metre, horizontal
+  0, 0, 0, 0, // pixels per metre, vertical
+  0, 0, 0, 0, // palette size
+  0, 0, 0, 0, // important colours
+];
+
+List<int> _le32(int value) => [
+  value & 0xFF,
+  (value >> 8) & 0xFF,
+  (value >> 16) & 0xFF,
+  (value >> 24) & 0xFF,
+];
diff --git a/windows/CMakeLists.txt b/windows/CMakeLists.txt
index c3c7c67..bd19cbd 100644
--- a/windows/CMakeLists.txt
+++ b/windows/CMakeLists.txt
@@ -52,6 +52,45 @@ add_subdirectory(${FLUTTER_MANAGED_DIR})
 # Application build; see runner/CMakeLists.txt.
 add_subdirectory("runner")
 
+# === The PixelSmith engine ===
+# Same reasoning as linux/CMakeLists.txt: nothing else in this build compiles the
+# Rust cdylib, so without these rules the packaged EXE has no pixelsmith_core.dll
+# beside it and the first engine call fails at load time. build-engine.sh is the
+# one script that knows how, and it is what the README and CI use.
+set(PIXELSMITH_ENGINE_SCRIPT "${CMAKE_CURRENT_SOURCE_DIR}/../native/build-engine.sh")
+set(PIXELSMITH_ENGINE_OUT "${CMAKE_CURRENT_SOURCE_DIR}/../src/rust")
+
+# Empty means "work it out": the script looks for a sibling pixelsmith checkout
+# and then for the superproject layout, which is what a submodule checkout is.
+set(PIXELSMITH_ENGINE_DIR "" CACHE PATH
+  "Path to the pixelsmith engine checkout. Empty: let build-engine.sh find it.")
+
+find_program(PIXELSMITH_BASH bash)
+if(NOT PIXELSMITH_BASH)
+  # Git Bash ships with Git for Windows and is on PATH in CI. If it is genuinely
+  # absent, failing here beats producing an EXE that cannot start.
+  message(FATAL_ERROR
+    "bash not found. build-engine.sh is a bash script and this project has no "
+    "other way to compile the engine. Install Git for Windows (its bin is on "
+    "PATH), or build the engine by hand with `bash native/build-engine.sh`.")
+endif()
+
+set(PIXELSMITH_ENGINE_ARGS "")
+if(PIXELSMITH_ENGINE_DIR)
+  list(APPEND PIXELSMITH_ENGINE_ARGS --engine-dir "${PIXELSMITH_ENGINE_DIR}")
+endif()
+
+add_custom_target(pixelsmith_engine ALL
+  COMMAND "${PIXELSMITH_BASH}" "${PIXELSMITH_ENGINE_SCRIPT}"
+          ${PIXELSMITH_ENGINE_ARGS}
+          # Debug gets a debug engine: the release profile sets panic = "abort",
+          # which makes the self-test panic abort instead of returning an error.
+          $<$<NOT:$<CONFIG:Debug>>:--release>
+  WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/.."
+  COMMENT "Building the PixelSmith engine ($<CONFIG>)"
+  VERBATIM)
+add_dependencies(${BINARY_NAME} pixelsmith_engine)
+
 
 # Generated plugin build rules, which manage building the plugins and adding
 # them to the application.
@@ -87,6 +126,13 @@ if(PLUGIN_BUNDLED_LIBRARIES)
     COMPONENT Runtime)
 endif()
 
+# The engine, built by the pixelsmith_engine target above. On Windows
+# INSTALL_BUNDLE_LIB_DIR is the EXE's own directory, which is where
+# loadEngineLibrary() looks for pixelsmith_core.dll.
+install(FILES "${PIXELSMITH_ENGINE_OUT}/pixelsmith_core.dll"
+  DESTINATION "${INSTALL_BUNDLE_LIB_DIR}"
+  COMPONENT Runtime)
