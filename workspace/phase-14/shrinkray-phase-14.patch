+  static SkipReason fromJson(Map<String, Object?> json) {
+    final String kind = json['kind'] as String;
+    return switch (kind) {
+      'duplicate' => SkipReasonDuplicate(json['of'] as String),
+      'unreadable' => const SkipReasonUnreadable(),
+      'unsupported_format' => SkipReasonUnsupportedFormat(
+        json['format'] as String,
+      ),
+      'too_large' => SkipReasonTooLarge(
+        limit: (json['limit'] as num).toInt(),
+        actual: (json['actual'] as num).toInt(),
+        pixels: json['unit'] == 'pixels',
+      ),
+      'would_upscale' => SkipReasonWouldUpscale(
+        requestedWidth: (json['requested'] as List)[0] as int,
+        requestedHeight: (json['requested'] as List)[1] as int,
+        actualWidth: (json['actual'] as List)[0] as int,
+        actualHeight: (json['actual'] as List)[1] as int,
+      ),
+      // An engine newer than this app can name an answer we do not know. Refusing
+      // to parse would turn "one new reason" into a crash on every file in the
+      // folder, which is exactly the sort of small contract drift the engine's
+      // capability list is meant to prevent.
+      _ => const SkipReasonUnreadable(),
+    };
