+/// What a batch does with a file it will not process.
+///
+/// Mirrors `BatchPolicy` in `core/src/worker.rs`. The three answers are
+/// independent: a caller may want duplicates collapsed and still want a corrupt
+/// file reported as a failure, or the reverse. The engine's default is all three
+/// on, because for a folder the alternatives are silently dropping a file and
+/// silently failing one.
+final class BatchPolicy {
+  const BatchPolicy({
+    this.deduplicate = true,
+    this.skipUnprocessable = true,
+    this.skipUpscales = true,
+  });
+
+  /// Collapse a file whose content is already exported.
+  final bool deduplicate;
+
+  /// Report a file that cannot be processed at all as a skip with a reason rather
+  /// than as a failure.
+  final bool skipUnprocessable;
+
+  /// Report a file whose requested geometry is larger than the picture as a skip
+  /// rather than writing it out at its own size.
+  final bool skipUpscales;
+
+  /// Every answer on, which is also what an engine predating this model means.
+  static const BatchPolicy all = BatchPolicy();
+
+  /// Every answer off: report everything as a failure.
+  static const BatchPolicy none = BatchPolicy(
+    deduplicate: false,
+    skipUnprocessable: false,
+    skipUpscales: false,
+  );
+
+  Map<String, Object?> toJson() => {
+    'deduplicate': deduplicate,
+    'skip_unprocessable': skipUnprocessable,
+    'skip_upscales': skipUpscales,
+  };
+}
