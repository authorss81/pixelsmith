+/// have — deliberately, so a request cannot be misread — which is the right
+/// behaviour for a *request* and the wrong one here: an engine that starts
+/// reporting HEIC skips against an app that has not been taught HEIC would crash
+/// every report in the folder rather than render one line of it.
+final class SkipReasonUnsupportedFormat extends SkipReason {
+  const SkipReasonUnsupportedFormat(this.formatName) : format = null;
+
+  /// Parses when this app knows the format, and leaves [format] null when it does
+  /// not. Never throws.
+  factory SkipReasonUnsupportedFormat.known(String name) {
