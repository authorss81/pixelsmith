+/// the engine read the file, decided, and can say why. What it must never do is
+/// decide quietly, which is why this is one type per answer rather than a
+/// boolean.
+sealed class SkipReason {
+  const SkipReason();
+
+  /// Which answer this is, matching the engine's `kind` tag.
+  String get kind;
+
+  /// A sentence for the person whose folder this is, built here rather than
+  /// parsed out of an error string.
+  String get note;
