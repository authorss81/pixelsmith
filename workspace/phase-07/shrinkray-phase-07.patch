+  test('the encoder capabilities parse through the Dart model', () {
+    // `Capabilities.fromJson` casts every field, so a key the engine sends and
+    // the model does not name throws here rather than reading as absent in the
+    // UI. Asserted against the library that was actually loaded, not against a
+    // hand-written JSON literal, because the failure this guards against is
+    // precisely the model and the engine disagreeing.
+    final lib = _tryLoad();
+    if (lib == null) {
+      markTestSkipped(
+        'native library not built — run the native build first (see README.md)',
+      );
+      return;
+    }
+    final px = PxBindings(lib);
+    final buffer = px.version();
+    try {
+      final json =
+          jsonDecode(
+                utf8.decode(
+                  buffer.data.cast<ffi.Uint8>().asTypedList(buffer.len),
+                ),
+              )
+              as Map<String, Object?>;
+      final caps = Capabilities.fromJson(json);
+      expect(caps.jpegProgressive, isTrue);
+      expect(caps.jpegChromaSubsampling, isTrue);
+      // Writable and not readable: the default build has an AVIF encoder and no
+      // AV1 decoder. A model that collapsed these into one field would claim a
+      // round trip the engine cannot make.
+      expect(caps.avifEncode, isTrue);
+      expect(caps.avifDecode, isFalse);
+    } finally {
+      px.bufferFree(buffer);
+    }
+  });
 }
 
