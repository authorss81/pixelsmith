+// `java` is the Gradle java extension in a build script, so `java.util.Properties`
+// does not resolve without the import — and it resolved fine in an ad-hoc
+// snippet, which is why this is written down rather than discovered.
+import java.util.Properties
+
 plugins {
     id("com.android.application")
     // The Flutter Gradle Plugin must be applied after the Android and Kotlin Gradle plugins.
     id("dev.flutter.flutter-gradle-plugin")
 }
 
+// Release signing.
+//
+// A keystore is never committed to this repository and never will be: a release
+// key that is in git is a release key that is in every clone, every fork and
+// every CI log. Instead the workflow decodes one out of an Actions secret into
+// RUNNER_TEMP and writes android/key.properties, which is gitignored. See
+// docs/RELEASE.md §4 in the PixelSmith repository.
+//
+// When key.properties is absent — a contributor's machine, a fork, any CI run
+// without the secrets — the release build falls back to the standard Android
+// debug key and says so. That is deliberate: it produces an installable APK
+// (with USB debugging on) so every contributor can install the change they just
+// made, and it is not what Google Play accepts, which is stated rather than
+// discovered. Failing closed instead would mean the only person who can fix it
+// gets a red run.
+val keystorePropertiesFile = rootProject.file("key.properties")
+val keystoreProperties = Properties().apply {
+    if (keystorePropertiesFile.exists()) {
+        keystorePropertiesFile.inputStream().use { load(it) }
+    }
+}
+val hasReleaseSigning = keystorePropertiesFile.exists() &&
+    keystoreProperties.getProperty("storeFile")?.let { file(it).exists() } == true
+
 android {
     namespace = "dev.pixelsmith.shrinkray"
     compileSdk = flutter.compileSdkVersion
